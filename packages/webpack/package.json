{
  "name": "@style-this/webpack",
  "version": "0.5.0",
  "description": "CSS-in-JS library for the modern web - webpack plugin",
  "type": "module",
  "files": [
    "dist",
    "style-this.*"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "import": "./dist/core.mjs",
      "default": "./dist/core.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "build:dev": "pnpm build",
    "dev": "tsdown --watch",
    "lint": "eslint",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Publishing is only allowed from CI'); process.exit(1) }\""
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "@style-this/core": "workspace:*",
    "@types/node": "^24.10.1",
    "webpack": "^5.0.0"
  },
  "peerDependencies": {
    "webpack": "^5.0.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31"
  }
}
