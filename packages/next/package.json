{
  "name": "@style-this/next",
  "version": "0.6.1",
  "description": "CSS-in-JS library for the modern web - nextjs plugin",
  "type": "module",
  "files": [
    "dist",
    "style-this.*.css",
    "style-this.*.js"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./style-this.atomic.css": "./style-this.atomic.css",
    "./style-this.atomic-layers.css": "./style-this.atomic-layers.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "build:dev": "pnpm build",
    "dev": "tsdown --watch",
    "lint": "eslint",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Publishing is only allowed from CI'); process.exit(1) }\""
  },
  "dependencies": {
    "@style-this/core": "workspace:0.6.1",
    "@style-this/webpack": "workspace:0.6.1"
  },
  "peerDependencies": {
    "next": ">=16.2",
    "webpack": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "next": "16.2.12",
    "webpack": "^5.0.0"
  }
}
